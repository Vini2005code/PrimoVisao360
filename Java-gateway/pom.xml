<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

<!-- <?xml...>: Diz ao computador: "Isso é um arquivo de texto formatado em XML usando a codificação de caracteres UTF-8 (que aceita acentos)".

<project...> e xmlns: São regras de validação. Dizem para a sua IDE (como o VS Code ) quais são as tags permitidas aqui dentro. Assim, se você digitar algo errado, a ferramenta avisa na hora.

<modelVersion>: É a versão da estrutura do Maven. No mundo Java, 4.0.0 é o padrão inabalável há anos. -->

   
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version> 
        <relativePath/> 
    </parent>
  <!-- O "Pai" do nosso projeto. Aqui acontece a maior "mágica" do Spring Boot.
   No Java, bibliotecas dependem de outras bibliotecas. Se você errar as versões, o projeto quebra.
 Quando declaramos esse <parent>, dizemos: "Spring Boot, você é o pai deste projeto.
 Assuma a responsabilidade de garantir que todas as versões de todas as ferramentas que usarmos sejam perfeitamente compatíveis entre si".
  A versão 3.3.0 dita a versão de todo o nosso ecossistema. -->

    <groupId>br.com.primordial</groupId>
    <artifactId>visao360-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Visão 360 - Java Gateway</name>
    <description>Orquestrador Seguro e Guardião LGPD do Primordial DATA</description>

  <!--  <groupId>: É a "família" do projeto. 
  O padrão mundial do Java é usar o domínio da empresa ao contrário. Como o projeto é da sua empresa, usamos br.com.primordial.

<artifactId>: É o nome exato deste pedaço de software (o nosso microsserviço).

<version>: A versão atual do nosso código. 
A palavra SNAPSHOT é uma convenção do Java que significa: "Estamos em desenvolvimento ativo, esta não é uma versão finalizada".

<name> e <description>: Apenas textos descritivos para documentação interna. -->

    <!-- Versão do Java -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Nossas ferramentas de trabalho -->
    <dependencies>
        
        <!-- 1. Spring Web: Permite criar os Endpoints REST (Controllers) que o React vai chamar -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 2. Spring Data JPA: O nosso comunicador com o banco de dados. 
             É ele que vamos interceptar para injetar o 'clinic_id' e ativar o RLS -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 3. Driver do PostgreSQL: A ponte de rede direta entre o Java e o banco de dados -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 4. Lombok: Uma ferramenta maravilhosa que gera código repetitivo (como Getters e Setters) 
             automaticamente para nós, deixando os arquivos Java muito mais limpos -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <!-- Ferramenta para empacotar tudo num arquivo só no final -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>

<!-- 5. Spring AOP: Permite interceptar métodos do banco para injetar o RLS -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>