APP_ENV=development
SPRING_PROFILES_ACTIVE=mvp
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENABLE_DOCS=true
GROQ_API_KEY=gsk_substitua_por_um_segredo_real
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_MAX_RETRIES=1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
INTERNAL_API_KEY=substitua-por-um-segredo-com-32-caracteres
LOG_LEVEL=INFO

# PostgreSQL local usado pelo Java; o Python fica sem acesso direto no MVP.
DATABASE_ENABLED=false
# Endereco do PostgreSQL local usado pelo gateway Java.
DATABASE_NAME=Primordial_Interno
DATABASE_URL=postgresql://127.0.0.1:5432/Primordial_Interno
DATABASE_USERNAME=primordial_app
DATABASE_PASSWORD=substitua_por_um_segredo_real
DB_SCHEMA=ehr_teste
DATABASE_REQUIRE_SAFE_ROLE=true
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_CONNECT_MAX_ATTEMPTS=8
DATABASE_CONNECT_BACKOFF_INITIAL_SECONDS=0.5
DATABASE_CONNECT_BACKOFF_MAX_SECONDS=8
DATABASE_STATEMENT_TIMEOUT_MS=3000

# Voz do MVP: mock em memoria, sem carregar Whisper ou Piper.
VOICE_ENABLED=true
VOICE_MOCK_ENABLED=true
VOICE_STT_MODEL_PATH=./models/faster-whisper-base
VOICE_STT_MODEL_DIR=faster-whisper-base
VOICE_STT_LANGUAGE=pt
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_CPU_THREADS=2
VOICE_STT_MAX_CONCURRENCY=1
VOICE_TURN_MAX_CONCURRENCY=1
VOICE_QUEUE_TIMEOUT_SECONDS=0.25
VOICE_TTS_MODEL_PATH=./models/pt_BR-faber-medium.onnx
VOICE_TTS_CONFIG_PATH=./models/pt_BR-faber-medium.onnx.json
VOICE_MAX_AUDIO_BYTES=5242880
VOICE_MAX_SECONDS=30
VOICE_TTS_MAX_CHARACTERS=1000
