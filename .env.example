APP_ENV=development
CORS_ALLOWED_ORIGINS=
ENABLE_DOCS=true
GROQ_API_KEY=gsk_substitua_por_um_segredo_real
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_MAX_RETRIES=1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
INTERNAL_API_KEY=substitua-por-um-segredo-com-32-caracteres
LOG_LEVEL=INFO

# PostgreSQL do prontuario: use um usuario exclusivo, com somente CONNECT/USAGE/SELECT.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/Primordial_Interno
DB_SCHEMA=ehr_teste
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=3000

# Voz: STT e TTS locais; somente texto pseudonimizado chega ao LLM.
VOICE_ENABLED=false
VOICE_STT_MODEL_PATH=./models/faster-whisper-base
VOICE_STT_LANGUAGE=pt
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_CPU_THREADS=2
VOICE_STT_MAX_CONCURRENCY=1
VOICE_TTS_MODEL_PATH=./models/pt_BR-faber-medium.onnx
VOICE_TTS_CONFIG_PATH=./models/pt_BR-faber-medium.onnx.json
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_SECONDS=60
VOICE_TTS_MAX_CHARACTERS=1500
